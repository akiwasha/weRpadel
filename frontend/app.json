{
  "expo": {
    "name": "weRpadel",
    "slug": "werpadel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "werpadel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emergent.padelplay.y9om9x",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Voir les clubs de padel proches de vous",
        "NSPhotoLibraryUsageDescription": "Importer une photo de profil",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.padelplay.y9om9x",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB7pF328nibNoa3EJC20hZn96jmYR9pAlo"
        }
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Voir les clubs de padel proches de vous",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B15"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Importer une photo de profil",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2fc1d283-ca7d-4ef1-8c24-5fbe8800a229"
      }
    },
    "owner": "wantedfr"
  }
}
